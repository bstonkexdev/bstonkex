# BSTONKEX Backend Configuration
# Copy to .env and fill in production values.
# NEVER commit real API keys or secrets.

# ── Server ────────────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0
NODE_ENV=production

# ── WebSocket ─────────────────────────────────────────────────
WS_PATH=/ws
WS_MAX_CONNECTIONS=1000
WS_HEARTBEAT_MS=15000
WS_MAX_SUBSCRIPTIONS_PER_CLIENT=50

# ── RPC Endpoints (server-side, not exposed to frontend) ──────
BSC_RPC_URL=https://bsc-dataseed1.binance.org
BASE_RPC_URL=https://mainnet.base.org
ROBINHOOD_RPC_URL=https://rpc.ankr.com/robinhood
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ── Robinhood Chain Auth (if needed) ──────────────────────────
ROBINHOOD_RPC_API_KEY=

# ── Alchemy Robinhood (server-side only, NEVER expose to frontend) ──
# Used by /rpc/robinhood proxy endpoint. Keep out of any VITE_ env vars.
RH_ALCHEMY_API_KEY=

# ── Market Data ───────────────────────────────────────────────
DEXSCREENER_API=https://api.dexscreener.com
GECKOTERMINAL_API=https://api.geckoterminal.com/api/v2
POLL_INTERVAL_MS=15000

# ── Indexer (future) ──────────────────────────────────────────
# INDEXER_URL=http://localhost:3001
# INDEXER_KEY=

# ── Database (Railway PostgreSQL) ─────────────────────────────
# Railway injects DATABASE_URL automatically when you add a PostgreSQL
# service to your Railway project. Copy the value from Railway dashboard.
# NEVER commit real connection strings or expose them to the frontend.
DATABASE_URL=

# ── Reward Auth ────────────────────────────────────────────────
# HMAC secret for signing session tokens. Generate with: openssl rand -hex 32
SESSION_SECRET=
# Service key for internal reward endpoints (allocation, settle, reversal).
# Generate with: openssl rand -hex 32
REWARD_SERVICE_KEY=

# ── CORS ──────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://bstonkex.xyz,https://www.bstonkex.xyz,http://localhost:5173

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=info

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100