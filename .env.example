# BSTONKEX Provider Configuration
# Copy to .env and fill in production values.
# NEVER commit real API keys or secrets.

# ── BNB Chain ─────────────────────────────────────────────────
VITE_BNB_RPC_PRIMARY=https://bsc-dataseed1.binance.org
VITE_BNB_RPC_FALLBACK_1=https://bsc-dataseed2.binance.org
VITE_BNB_RPC_FALLBACK_2=https://rpc.ankr.com/bsc
VITE_BNB_EXPLORER_API=
VITE_BNB_ROUTER_API=https://api.1inch.dev/swap/v6.0

# ── Base ──────────────────────────────────────────────────────
VITE_BASE_RPC_PRIMARY=https://mainnet.base.org
VITE_BASE_RPC_FALLBACK_1=https://rpc.ankr.com/base
VITE_BASE_RPC_FALLBACK_2=https://base.llamarpc.com
VITE_BASE_EXPLORER_API=
VITE_BASE_ROUTER_API=https://api.1inch.dev/swap/v6.0

# ── Robinhood Chain ───────────────────────────────────────────
VITE_RH_RPC_PRIMARY=https://rpc.ankr.com/robinhood
VITE_RH_RPC_FALLBACK_1=https://robinhood-mainnet.g.alchemy.com/v2/demo
VITE_RH_ROUTER_API=https://api.1inch.dev/swap/v6.0

# ── Solana ────────────────────────────────────────────────────
VITE_SOL_RPC_PRIMARY=https://api.mainnet-beta.solana.com
VITE_SOL_RPC_FALLBACK_1=https://rpc.ankr.com/solana
VITE_SOL_RPC_FALLBACK_2=https://solana-mainnet.g.alchemy.com/v2/demo
VITE_SOL_ROUTER_API=https://quote-api.jup.ag/v6

# ── Admin Wallets (comma-separated EVM addresses) ────────────
# Only these wallets can access the Admin Deployment Center.
# Default authorized wallet is hardcoded: 0xb69d35a281bb9dd59b7abb65ee74d79b41a12090
# Add additional admin wallets here (comma-separated):
VITE_ADMIN_WALLETS=

# ── Shared API Keys (server-side only in production) ──────────
VITE_1INCH_API_KEY=

# ── WebSocket Gateway ────────────────────────────────────────
# Frontend connects to this URL. Set to your deployed backend.
VITE_WS_URL=wss://bstonkex-production-ec26.up.railway.app/ws

# ── Indexer (future — not used in browser-only mode) ─────────
# BSTONKEX_INDEXER_URL=
# BSTONKEX_INDEXER_KEY=

# ── Database (Gitlawb Data SDK — built-in, no external DB) ───
# No configuration needed — uses gitlawb.db.collection()

# ── Cache ─────────────────────────────────────────────────────
# In-memory TTL cache — no external cache server needed
# TTLs configured in src/lib/engine/cache.ts

# ── Admin ─────────────────────────────────────────────────────
# BSTONKEX_ADMIN_KEY=
# BSTONKEX_TREASURY_ADDRESS=